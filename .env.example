# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API). The anon key is safe in the app; the rules protect the data.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Used by the scheduled retention job. Never ship this in the app or website.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# How long signed video links last, in seconds
VIDEO_LINK_TTL_SECONDS=300
